								}
							}
						},
						"url": "{{baseUrl}}/auth/register"
					}
				},
				{
					"name": "Login and save token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Login status is 201 or 200', function () {",
									"  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"var data = {};",
									"try { data = pm.response.json(); } catch (e) { data = {}; }",
									"var token = data.token || data.access_token || (data.data && data.data.token);",
									"pm.test('Response has token', function () {",
									"  pm.expect(token).to.be.a('string').and.not.empty;",
									"});",
									"pm.collectionVariables.set('token', token);",
									"if (pm.environment && pm.environment.name) { pm.environment.set('token', token); }",
									"pm.globals.set('token', token);",
									"if (data.id) {",
									"  pm.collectionVariables.set('userId', data.id);",
									"  if (pm.environment && pm.environment.name) { pm.environment.set('userId', data.id); }",
									"}",
									"console.log('Token guardado en collection/environment/globals');"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
