


DATABASE_URL=postgresql://

# PostgreSQL pool (optional). See README "Conexiones a PostgreSQL / Neon".
# Idle connections are closed after DB_POOL_IDLE_TIMEOUT_MS (default 240000 = 4 min, keep it below
# Neon's 5 min scale-to-zero window). DB_POOL_MAX is the max connections per backend instance (default 10).
# DB_POOL_IDLE_TIMEOUT_MS=240000
# DB_POOL_MAX=10

# Do not set TZ: the backend always runs in UTC (see src/config/timezone.config.ts).

JWT_SECRET_KEY=replace_with_strong_secret


CLIENT_SECRET_GOOGLE=secret_client
CLIENT_ID_GOOGLE=client_id

# Develop Workflow attachments (Cloudinary)
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret
CLOUDINARY_WORKSPACE_FOLDER=folder

# Max upload size for /workspace/discussions/:discussionId/messages/files
WORKSPACE_ATTACHMENT_MAX_FILE_SIZE_BYTES=26214400


# Firebase Admin (push FCM). Absolute path to the service account JSON of the Firebase project used
# by the Flutter app (same project_id as google-services.json). Keep the file OUTSIDE any repository.
# On Render: upload it as a Secret File and point this to /etc/secrets/<file-name>.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/the/repo/firebase-service-account.json
# Optional: defaults to the project_id of the service account.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: automatic pushes skip devices that did not register their token in this many days
# (positive integer). Rows are not deleted. Unset = no filtering.
# FCM_DEVICE_STALE_AFTER_DAYS=60

# Transactional email (Brevo HTTP API). MAIL_FROM_EMAIL must be a sender verified in Brevo.
BREVO_API_KEY=replace_with_brevo_api_key
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=TeamFlow

# HMAC secret for security verification codes (long random value, e.g. openssl rand -hex 32)
SECURITY_VERIFICATION_SECRET=replace_with_strong_secret