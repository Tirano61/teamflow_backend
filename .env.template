


DATABASE_URL=postgresql://

JWT_SECRET_KEY=replace_with_strong_secret


CLIENT_SECRET_GOOGLE=secret_client
CLIENT_ID_GOOGLE=client_id

# Develop Workflow attachments (Cloudinary)
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret
CLOUDINARY_WORKSPACE_FOLDER=folder

# Max upload size for /workspace/discussions/:discussionId/messages/files
WORKSPACE_ATTACHMENT_MAX_FILE_SIZE_BYTES=26214400


GOOGLE_APPLICATION_CREDENTIALS=D:/NEST + FLUTTER/BotServices/teamflow-workspace.json

# Transactional email (Brevo HTTP API). MAIL_FROM_EMAIL must be a sender verified in Brevo.
BREVO_API_KEY=replace_with_brevo_api_key
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=TeamFlow

# HMAC secret for security verification codes (long random value, e.g. openssl rand -hex 32)
SECURITY_VERIFICATION_SECRET=replace_with_strong_secret